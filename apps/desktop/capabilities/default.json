{
  "identifier": "default",
  "description": "Window controls and native dialogs for the editor.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-save-file"
  ]
}
